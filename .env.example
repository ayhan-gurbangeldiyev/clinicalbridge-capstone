# ======================================================================
#  ClinicalBridge — environment configuration
# ----------------------------------------------------------------------
#  SETUP (3 steps):
#    1. Copy this file to ".env"            ->  cp .env.example .env
#    2. Choose a provider (Azure OR OpenAI) and paste YOUR OWN key below.
#    3. Save. That's it — `.env` is gitignored and never committed.
#
#  You only need ONE provider. Pick Option A (Azure) or Option B (OpenAI).
#  Do NOT commit real keys anywhere (report, code, comments) — only here,
#  locally.
# ======================================================================

# Which provider to use:  true = Azure OpenAI (Option A),  false = OpenAI (Option B)
USE_AZURE=true


# ── Option A: Azure OpenAI  (used when USE_AZURE=true) ────────────────
# Get these from Azure Portal -> your Azure OpenAI resource -> "Keys and Endpoint",
# and the deployment names from Azure AI Foundry -> "Model deployments".
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_KEY=PASTE_YOUR_AZURE_KEY_HERE
AZURE_OPENAI_DEPLOYMENT=gpt-4o                       # your chat deployment name
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small  # your embedding deployment name


# ── Option B: OpenAI API  (used when USE_AZURE=false) ────────────────
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# ── Embeddings: no embedding deployment? Use a free local model ──────
# Set true to use ChromaDB's built-in local model (all-MiniLM-L6-v2) for RAG
# instead of an Azure/OpenAI embedding deployment. No API key needed for embeddings.
USE_LOCAL_EMBEDDINGS=false


# ── LangFuse observability (OPTIONAL — leave as-is to skip) ──────────
# The system runs fine without these; tracing is simply disabled.
# To enable: create a free project at https://cloud.langfuse.com and paste the keys.
LANGFUSE_PUBLIC_KEY=pk-lf-PASTE_IF_YOU_WANT_TRACING
LANGFUSE_SECRET_KEY=sk-lf-PASTE_IF_YOU_WANT_TRACING
LANGFUSE_HOST=https://cloud.langfuse.com


# ── ChromaDB vector store location (no need to change) ───────────────
CHROMA_PERSIST_DIR=./vectorstore
